@model LoginViewModel
@{
    Layout = null;
    var notice = ViewData["Notice"] as (string Type, string Text)?;
    var hasErrors = !ViewData.ModelState.IsValid;
    var emailError = ViewData.ModelState[nameof(LoginViewModel.Email)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var passwordError = ViewData.ModelState[nameof(LoginViewModel.Password)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var formError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Ingresar — _admin</title>
    <style>html,body{background:#070B14}html:not(.icons-ready) .ms{visibility:hidden}</style>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@500;700&amp;family=Space+Grotesk:wght@500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0&amp;display=block" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    @* Va después de las hojas de estilo: así la fuente ya está declarada y load() espera a que descargue *@
    <script>document.fonts&&document.fonts.load('20px "Material Symbols Outlined"','lock').then(function(){document.documentElement.classList.add('icons-ready')})</script>
</head>
<body>
    <div class="bg" aria-hidden="true"><div class="grid"></div><div class="orb a"></div><div class="orb b"></div><canvas id="particles"></canvas></div>

    <main class="shell">
        <section class="context" aria-label="Área administrativa">
            <a href="/" class="logo"><span>&gt;_</span>raul.dev</a>
            <div class="copy">
                <span class="pill"><i></i>SISTEMA SEGURO</span>
                <h1>Tu sitio,<br /><em>bajo control.</em></h1>
                <p>Administra proyectos, servicios, contenido y mensajes desde un solo lugar.</p>
            </div>
            <div class="terminal" aria-hidden="true">
                <div class="terminal-bar"><i></i><i></i><i></i><span>_admin — ~/auth</span></div>
                <div class="terminal-body"><p><b>~</b> auth --status</p><p><span>✓</span> conexión cifrada</p><p><span>✓</span> acceso protegido</p><p><b>~</b> <i class="cursor"></i></p></div>
            </div>
        </section>

        <section class="card" aria-labelledby="loginTitle">
            <div class="card-head">
                <span class="card-icon"><span class="ms">lock</span></span>
                <div><p class="kicker">_ADMIN</p><h2 id="loginTitle">Bienvenido de vuelta</h2></div>
            </div>
            <p class="intro">Ingresa tus credenciales para continuar.</p>

            @if (formError is not null)
            {
                <div class="alert error" role="alert" id="formAlert"><span class="ms">error</span><p>@formError</p></div>
            }
            else if (notice is { } n)
            {
                <div class="alert @(n.Type == "ok" ? "ok" : "error")" role="@(n.Type == "ok" ? "status" : "alert")" id="formAlert"><span class="ms">@(n.Type == "ok" ? "check_circle" : "timer")</span><p>@n.Text</p></div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" novalidate id="loginForm" data-has-errors="@(hasErrors ? "true" : "false")">
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="field @(emailError is null ? "" : "invalid")">
                    <label for="Email">Correo electrónico</label>
                    <div class="input-wrap">
                        <span class="ms" aria-hidden="true">mail</span>
                        <input id="Email" name="Email" type="email" value="@Model.Email" required maxlength="160"
                               autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false"
                               placeholder="correo@ejemplo.com" aria-describedby="emailError" aria-invalid="@(emailError is null ? "false" : "true")" />
                    </div>
                    <span class="error" id="emailError" aria-live="polite">@emailError</span>
                </div>

                <div class="field @(passwordError is null ? "" : "invalid")">
                    <label for="Password">Contraseña</label>
                    <div class="input-wrap">
                        <span class="ms" aria-hidden="true">key</span>
                        <input id="Password" name="Password" type="password" required maxlength="200"
                               autocomplete="current-password" autocapitalize="none" spellcheck="false"
                               placeholder="••••••••••" aria-describedby="passwordError capsWarning" aria-invalid="@(passwordError is null ? "false" : "true")" />
                        <button type="button" class="toggle" id="togglePassword" aria-label="Mostrar contraseña" aria-controls="Password" aria-pressed="false"><span class="ms">visibility</span></button>
                    </div>
                    <span class="caps" id="capsWarning" hidden><span class="ms">keyboard_capslock</span>Bloq Mayús está activado</span>
                    <span class="error" id="passwordError" aria-live="polite">@passwordError</span>
                </div>

                <label class="remember"><input asp-for="RememberMe" /><span class="check" aria-hidden="true"><span class="ms">check</span></span><span>Mantener sesión iniciada</span></label>

                <button class="submit" type="submit" id="loginButton">
                    <span class="spinner" aria-hidden="true"></span>
                    <span data-label>Iniciar sesión</span>
                    <span class="ms arrow" aria-hidden="true">arrow_forward</span>
                </button>
                <noscript><p class="note">JavaScript está desactivado; la validación se hará al enviar.</p></noscript>
            </form>

            <p class="note"><span class="ms">shield</span>Después de varios intentos fallidos, el acceso se bloquea unos minutos.</p>
            <a href="/" class="back"><span class="ms">arrow_back</span>Volver al sitio</a>
        </section>
    </main>

    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
