@model IReadOnlyList<AppItem>
@foreach (var app in Model)
{
    var typeLabel = app.ProjectType switch { "client" => "Empresa / Cliente", "opensource" => "Open Source", "leisure" => "Ocio", "experimental" => "Experimental", "community" => "Comunidad", _ => "Proyecto Personal" };
    var categoryLabel = app.Icon switch { "smartphone" => "App Móvil", "language" => "Plataforma Web", "deployed_code" => "Software", "construction" => "Herramienta", "psychology" => "Inteligencia Artificial", "sports_esports" => "Videojuego", "task_alt" => "Productividad", "shopping_cart" => "E-commerce", "payments" => "Finanzas", "school" => "Educación", "favorite" => "Bienestar", "groups" => "Social", "photo_camera" => "Fotografía", "music_note" => "Música", "cloud" => "Servicio Cloud", "security" => "Seguridad", "analytics" => "Analítica", _ => "Aplicación" };
    var isGitHub = app.Url?.Contains("github.com", StringComparison.OrdinalIgnoreCase) == true;
    <article class="app-card reveal-scale flex flex-col">
        <div class="flex justify-center items-end px-8 bg-bg-base/50" style="padding-top:2rem;padding-bottom:0">
            <div class="phone-frame-sm">
                <div class="phone-notch-sm"><div class="phone-camera-sm"></div></div>
                <div class="phone-viewport-sm">
                    @if (!string.IsNullOrWhiteSpace(app.ImageUrl))
                    {
                        <img alt="@app.Name" src="@app.ImageUrl" loading="lazy" decoding="async" class="w-full h-full object-cover object-top" />
                    }
                    else
                    {
                        <div class="w-full h-full flex flex-col items-center justify-center gap-3 text-primary" style="background:linear-gradient(160deg,var(--bg-surface),var(--bg-card))"><span class="material-symbols-outlined text-5xl">@app.Icon</span><span class="font-mono text-[9px] uppercase tracking-widest opacity-60">@app.Name</span></div>
                    }
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-4 p-6 flex-1">
            <div class="flex items-center justify-between gap-3">
                <span class="app-badge" style="background:rgba(0,217,163,.1);color:var(--accent)">@typeLabel</span>
                <div class="size-10 shrink-0 rounded-xl flex items-center justify-center text-primary border border-primary/20 bg-primary/10" title="@categoryLabel" aria-label="Categoría: @categoryLabel"><span class="material-symbols-outlined text-[21px]">@app.Icon</span></div>
            </div>
            <div><h3 class="text-xl font-black tracking-tight text-white mb-1.5">@app.Name</h3><p class="text-text-secondary text-sm leading-relaxed" style="-webkit-line-clamp:3;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden">@app.Description</p></div>
            @if (!string.IsNullOrWhiteSpace(app.Technologies))
            {
                <div class="flex flex-wrap gap-1.5">@foreach (var technology in app.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <span class="tech-pill bg-primary/20 text-primary border-primary/30">@technology</span> }</div>
            }
            @if (!string.IsNullOrWhiteSpace(app.Url))
            {
                <a href="@app.Url" target="_blank" rel="noopener noreferrer" class="app-github-btn mt-auto">
                    @if (isGitHub) { <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg> } else { <span class="material-symbols-outlined text-[16px]">open_in_new</span> }
                    @(isGitHub ? "Ver en GitHub" : "Abrir aplicación")
                </a>
            }
        </div>
    </article>
}
