@model HomeViewModel
@using System.Text.Json.Nodes
@{
    Layout = null;
    var featured = Model.Projects.FirstOrDefault(p => p.IsFeatured) ?? Model.Projects.FirstOrDefault();
    var others = Model.Projects.Where(p => p != featured).ToList();
    var featuredScreens = featured is null ? []
        : featured.GalleryList.Count > 0 ? featured.GalleryList.ToList()
        : string.IsNullOrWhiteSpace(featured.DesktopImageUrl) ? [] : [("", featured.DesktopImageUrl!)];
    var heroImage = featuredScreens.Count > 0 ? featuredScreens[0].Url : null;
    var featuredHost = Uri.TryCreate(featured?.WebsiteUrl, UriKind.Absolute, out var featuredUri) ? featuredUri.Host.Replace("www.", "") : null;
    var presentTypes = Project.TypeOptions.Where(t => Model.Projects.Any(p => p.TypeList.Contains(t.Key))).ToList();
    var whatsAppUrl = Model.Settings.Phone.Any(char.IsDigit) ? Model.Settings.WhatsAppUrl : string.Empty;
    var heroLead = string.IsNullOrWhiteSpace(Model.Settings.HeroText)
        ? "Páginas web y sistemas a la medida para negocios que quieren más clientes y menos trabajo manual. Te lo explico sin tecnicismos y ves avances cada semana."
        : Model.Settings.HeroText;
    var isAdmin = User.Identity?.IsAuthenticated == true;
    var adminUrl = isAdmin ? "/admin" : "/admin/login";
    string[] cardBackgrounds = ["linear-gradient(160deg,#1d3a5c,#0d1626)", "linear-gradient(160deg,#145c3c,#0b2a1e)", "linear-gradient(160deg,#3b2a5c,#150f26)", "linear-gradient(160deg,#5c3a14,#26170b)"];
    IEnumerable<(string Key, string Label, string Icon, string Css)> TypesOf(Project project) => Project.TypeOptions
        .Where(t => project.TypeList.Contains(t.Key))
        .Select(t => (t.Key, t.Label, t.Icon, t.Key switch { "sistema" => "t-sys", "app" => "t-app", "tienda" => "t-shop", _ => "t-web" }));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <style>html,body{background:#070B14}</style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/landing.css?v=2">

    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">

    @{
        var seoTitle = string.IsNullOrWhiteSpace(Model.Settings.SeoTitle) ? "Raúl Pimentel | Desarrollador Web Full Stack en Puebla, México" : Model.Settings.SeoTitle;
        var seoDescription = string.IsNullOrWhiteSpace(Model.Settings.SeoDescription) ? "Desarrollador web Full Stack freelance en Puebla, México." : Model.Settings.SeoDescription;
        var seoImageRaw = string.IsNullOrWhiteSpace(Model.Settings.SeoImageUrl) ? "https://pimentel.cloud/assets/img/logo/og-image.jpeg" : Model.Settings.SeoImageUrl;
        var seoImage = seoImageRaw.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? seoImageRaw : $"{Context.Request.Scheme}://{Context.Request.Host}{seoImageRaw}";
        var offers = new JsonArray(Model.Services.Select(s => (JsonNode)new JsonObject {
            ["@type"] = "Offer",
            ["itemOffered"] = new JsonObject { ["@type"] = "Service", ["name"] = s.Title, ["description"] = s.Description },
        }).ToArray());
        var sameAsArray = new JsonArray(new[] { Model.Settings.LinkedInUrl, Model.Settings.GitHubUrl }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => (JsonNode)x).ToArray());

        var personSchemaJson = new JsonObject {
            ["@context"] = "https://schema.org",
            ["@type"] = "Person",
            ["@id"] = "https://pimentel.cloud/#person",
            ["name"] = Model.Settings.OwnerName,
            ["givenName"] = "Raúl",
            ["familyName"] = "Pimentel",
            ["jobTitle"] = Model.Settings.Headline,
            ["description"] = seoDescription,
            ["url"] = "https://pimentel.cloud/",
            ["email"] = Model.Settings.Email,
            ["telephone"] = Model.Settings.Phone,
            ["image"] = seoImage,
            ["address"] = new JsonObject { ["@type"] = "PostalAddress", ["addressLocality"] = "Puebla", ["addressRegion"] = "Puebla", ["postalCode"] = "72000", ["addressCountry"] = "MX" },
            ["knowsAbout"] = new JsonArray("Laravel", "Vue.js", "MySQL", "HTML", "CSS", "Tailwind CSS", "SEO", "Diseño web responsive", "PHP", "JavaScript"),
            ["sameAs"] = sameAsArray.DeepClone(),
        }.ToJsonString();

        var serviceSchemaJson = new JsonObject {
            ["@context"] = "https://schema.org",
            ["@type"] = "ProfessionalService",
            ["@id"] = "https://pimentel.cloud/#service",
            ["name"] = "Raúl Pimentel | Dev",
            ["alternateName"] = "Raúl Web Dev",
            ["url"] = "https://pimentel.cloud/",
            ["logo"] = "https://pimentel.cloud/assets/img/logo/logo.png",
            ["image"] = seoImage,
            ["description"] = seoDescription,
            ["priceRange"] = "$$",
            ["email"] = Model.Settings.Email,
            ["telephone"] = Model.Settings.Phone,
            ["address"] = new JsonObject { ["@type"] = "PostalAddress", ["addressLocality"] = "Puebla", ["addressRegion"] = "Puebla", ["postalCode"] = "72000", ["addressCountry"] = "MX" },
            ["geo"] = new JsonObject { ["@type"] = "GeoCoordinates", ["latitude"] = 19.0414, ["longitude"] = -98.2063 },
            ["areaServed"] = new JsonArray(new JsonObject { ["@type"] = "Country", ["name"] = "México" }, new JsonObject { ["@type"] = "State", ["name"] = "Puebla" }),
            ["hasOfferCatalog"] = new JsonObject { ["@type"] = "OfferCatalog", ["name"] = "Servicios de Desarrollo Web", ["itemListElement"] = offers },
            ["founder"] = new JsonObject { ["@id"] = "https://pimentel.cloud/#person" },
            ["sameAs"] = sameAsArray,
        }.ToJsonString();

        var websiteSchemaJson = new JsonObject {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["@id"] = "https://pimentel.cloud/#website",
            ["url"] = "https://pimentel.cloud/",
            ["name"] = "Raúl Pimentel | Dev",
            ["alternateName"] = "Raúl Pimentel – Desarrollador Web Full Stack",
            ["publisher"] = new JsonObject { ["@id"] = "https://pimentel.cloud/#person" },
        }.ToJsonString();
    }
    <title>@seoTitle</title>
    <meta name="description" content="@seoDescription" />
    <meta name="robots" content="@(Model.Settings.IsIndexable ? "index, follow" : "noindex, nofollow")" />
    <meta name="author" content="@Model.Settings.OwnerName" />
    @if (!string.IsNullOrWhiteSpace(Model.Settings.SeoKeywords))
    {
        <meta name="keywords" content="@Model.Settings.SeoKeywords" />
    }

    <!-- Geo / Local SEO -->
    <meta name="geo.region" content="MX-PUE" />
    <meta name="geo.placename" content="Puebla, México" />
    <meta name="geo.position" content="19.0414;-98.2063" />
    <meta name="ICBM" content="19.0414, -98.2063" />

    <link rel="canonical" href="https://pimentel.cloud/" />
    <link rel="alternate" hreflang="es" href="https://pimentel.cloud/" />
    <link rel="alternate" hreflang="es-MX" href="https://pimentel.cloud/" />
    <link rel="alternate" hreflang="x-default" href="https://pimentel.cloud/" />

    <!-- Open Graph -->
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@seoTitle" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:url" content="https://pimentel.cloud/" />
    <meta property="og:image" content="@seoImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@Model.Settings.OwnerName – @Model.Settings.Headline" />
    <meta property="og:site_name" content="Raúl Pimentel | Dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@seoDescription" />
    <meta name="twitter:image" content="@seoImage" />
    <meta name="twitter:image:alt" content="@Model.Settings.OwnerName – @Model.Settings.Headline" />

    @if (!string.IsNullOrWhiteSpace(Model.Settings.GoogleSiteVerification))
    {
        <meta name="google-site-verification" content="@Model.Settings.GoogleSiteVerification" />
    }

    <!-- Schema: Person / ProfessionalService / WebSite —
         emitidos como HTML crudo: cualquier <script> pasa por el ScriptTagHelper
         de ASP.NET Core, que re-codifica sus atributos (ej. "+" → "&#x2B;") aunque
         no use asp-src ni versión; Html.Raw evita que el tag helper los toque. -->
    @Html.Raw($"<script type=\"application/ld+json\">{personSchemaJson.Replace("</", "<\\/")}</script>")
    @Html.Raw($"<script type=\"application/ld+json\">{serviceSchemaJson.Replace("</", "<\\/")}</script>")
    @Html.Raw($"<script type=\"application/ld+json\">{websiteSchemaJson.Replace("</", "<\\/")}</script>")

    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#4A9EFF" />
    <meta name="theme-color" content="#070B14" />
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.svg?v=2" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&family=JetBrains+Mono:wght@@500;700&family=Space+Grotesk:wght@@500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,400,0,0&display=block" rel="stylesheet">
</head>
<body data-whatsapp="@whatsAppUrl">

<header class="nav" id="nav"><div class="read-bar" id="readBar"></div>
  <div class="wrap">
    <a href="#" class="logo"><span>&gt;_</span>raul.dev</a>
    <nav class="nav-links" aria-label="Secciones">
      <a href="#diagnostico">¿Qué necesito?</a>
      @if (Model.Services.Count > 0) { <a href="#soluciones">Soluciones</a> }
      @if (featured is not null) { <a href="#proyectos">Proyectos</a> }
      <a href="#confianza">Garantías</a>
      @if (Model.Faqs.Count > 0) { <a href="#faq">Preguntas</a> }
    </nav>
    <div class="nav-actions">
      <a href="#contacto" class="btn btn-primary nav-cta">Platiquemos gratis <span class="ms">arrow_forward</span></a>
    </div>
    <button class="burger" id="burger" aria-label="Menú" aria-expanded="false" aria-controls="mobileMenu"><span class="ms">menu</span></button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#diagnostico"><span class="ms">quiz</span>¿Qué necesito?</a>
    @if (Model.Services.Count > 0) { <a href="#soluciones"><span class="ms">design_services</span>Soluciones</a> }
    @if (featured is not null) { <a href="#proyectos"><span class="ms">work</span>Proyectos</a> }
    <a href="#confianza"><span class="ms">verified_user</span>Garantías</a>
    <a href="#proceso"><span class="ms">route</span>Cómo trabajamos</a>
    @if (Model.Faqs.Count > 0) { <a href="#faq"><span class="ms">help</span>Preguntas</a> }
    <a href="#contacto" class="btn btn-primary">Platiquemos gratis <span class="ms">arrow_forward</span></a>
  </div>
</header>

<main>
<!-- HERO -->
<section class="hero">
  <div class="hero-bg"><div class="grid"></div><div class="orb a"></div><div class="orb b"></div><canvas id="particles" aria-hidden="true"></canvas></div>
  <div class="wrap">
    <div>
      <span class="pill reveal"><i></i>Agenda abierta · @(string.IsNullOrWhiteSpace(Model.Settings.Location) ? "todo México" : Model.Settings.Location)</span>
      <h1 class="reveal d1">Llevo tu negocio a internet para que <span class="rotator" id="rot">te encuentren</span></h1>
      <p class="lead reveal d2">@heroLead</p>
      <div class="hero-ctas reveal d3">
        <a href="#diagnostico" class="btn btn-primary"><span class="ms">quiz</span>Descubre qué necesitas · 1 min</a>
        @if (featured is not null) { <a href="#proyectos" class="btn btn-ghost"><span class="ms">visibility</span>Ver proyectos</a> }
      </div>
      <div class="trust reveal d4">
        <span><b class="ms">schedule</b>Respuesta en menos de 24 h</span>
        <span><b class="ms">payments</b>Pagas por etapas</span>
        <span><b class="ms">key</b>Todo queda a tu nombre</span>
      </div>
    </div>
    @if (heroImage is not null)
    {
      <div class="stage" id="stage">
        <div class="browser real" id="browser">
          <div class="bar"><i></i><i></i><i></i><div class="url"><b>@featured!.Title</b>@(featuredHost is null ? "" : $" · {featuredHost}")</div></div>
          <img class="shot" src="@heroImage" alt="@featured.Title" fetchpriority="high">
        </div>
        @if (!string.IsNullOrWhiteSpace(featured.MobileImageUrl))
        {
          <div class="phone"><img src="@featured.MobileImageUrl" alt="@featured.Title en celular" loading="lazy"></div>
        }
        <div class="float f1 on"><div class="ic"><span class="ms">notifications_active</span></div><div><strong>Nuevo cliente</strong><small>escribió desde tu página</small></div></div>
        <div class="float f2 on"><div class="ic"><span class="ms">verified</span></div><div><strong>Proyecto real</strong><small>@featured.Title</small></div></div>
      </div>
    }
  </div>
</section>

<!-- PAINS -->
<section class="pains">
  <div class="wrap">
    <div class="head-center">
      <span class="eyebrow reveal">¿Te suena?</span>
      <h2 class="h2 reveal d1">No necesitas saber de tecnología.<br>Solo saber <span class="grad">qué te está frenando</span>.</h2>
      <p class="lead reveal d2">Estas son las frases que más escucho de dueños de negocio. Cada una tiene una solución concreta.</p>
    </div>
    <div class="pain-grid">
      <div class="card pain reveal"><q>Mis clientes no me encuentran en Google.</q><div class="fix"><span class="ms">arrow_forward</span><div><b>Página web con <span class="term" tabindex="0" data-term="seo">SEO local</span></b><br>Apareces cuando buscan lo que vendes en tu ciudad.</div></div></div>
      <div class="card pain reveal d1"><q>Todo lo hago por WhatsApp y se me pierden pedidos.</q><div class="fix"><span class="ms">arrow_forward</span><div><b>Sistema de pedidos o citas</b><br>Tus clientes reservan solos y tú ves todo ordenado.</div></div></div>
      <div class="card pain reveal d2"><q>Tengo página, pero nadie me escribe.</q><div class="fix"><span class="ms">arrow_forward</span><div><b>Rediseño enfocado en ventas</b><br>Rápida, clara y con botones que invitan a contactarte.</div></div></div>
      <div class="card pain reveal d3"><q>Llevo el negocio en Excel y libretas.</q><div class="fix"><span class="ms">arrow_forward</span><div><b>Sistema a la medida</b><br>Clientes, inventario y reportes en un solo lugar.</div></div></div>
    </div>
  </div>
</section>

<!-- DIAGNÓSTICO -->
<section id="diagnostico">
  <div class="wrap diag">
    <div class="diag-copy">
      <span class="eyebrow reveal">Diagnóstico rápido</span>
      <h2 class="h2 reveal d1">¿No sabes qué necesitas? <span class="grad">Te ayudo a averiguarlo.</span></h2>
      <p class="lead reveal d2">Responde 3 preguntas y te digo qué solución le queda a tu negocio, cuánto tarda y qué incluye. Sin registrarte y sin compromiso.</p>
      <ul class="reveal d3">
        <li><span class="ms">check_circle</span>Una recomendación en palabras simples</li>
        <li><span class="ms">check_circle</span>El tiempo aproximado de entrega</li>
        <li><span class="ms">check_circle</span>Si no estás seguro, lo platicamos gratis</li>
      </ul>
    </div>
    <div class="card quiz reveal d2" id="quiz">
      <div class="quiz-top"><span class="mono" id="qLabel">pregunta 1 de 3</span><span class="mono" style="color:var(--accent)">~1 min</span></div>
      <div class="progress"><i id="qBar"></i></div>
      <div class="quiz-body">
        <div class="step on" data-step="0">
          <h3>¿Qué tipo de negocio tienes?</h3><p class="sub">Elige el más parecido.</p>
          <div class="opts">
            <button type="button" class="opt" data-v="servicios"><span class="ms">spa</span>Servicios con citas<br>(spa, clínica, consultorio)</button>
            <button type="button" class="opt" data-v="tienda"><span class="ms">storefront</span>Vendo productos</button>
            <button type="button" class="opt" data-v="profesional"><span class="ms">work</span>Profesionista o despacho</button>
            <button type="button" class="opt" data-v="operacion"><span class="ms">factory</span>Empresa con procesos internos</button>
          </div>
        </div>
        <div class="step" data-step="1">
          <h3>¿Cómo te encuentran hoy tus clientes?</h3><p class="sub">Sé honesto, no hay respuesta mala.</p>
          <div class="opts">
            <button type="button" class="opt" data-v="nada"><span class="ms">person_search</span>De boca en boca</button>
            <button type="button" class="opt" data-v="redes"><span class="ms">share</span>Solo por redes sociales</button>
            <button type="button" class="opt" data-v="web"><span class="ms">language</span>Tengo página pero no funciona</button>
            <button type="button" class="opt" data-v="ok"><span class="ms">thumb_up</span>Me encuentran bien, quiero crecer</button>
          </div>
        </div>
        <div class="step" data-step="2">
          <h3>¿Qué te quita más tiempo?</h3><p class="sub">Lo que más te gustaría dejar de hacer a mano.</p>
          <div class="opts">
            <button type="button" class="opt" data-v="citas"><span class="ms">calendar_month</span>Agendar y confirmar citas</button>
            <button type="button" class="opt" data-v="pedidos"><span class="ms">shopping_bag</span>Tomar pedidos y cobrar</button>
            <button type="button" class="opt" data-v="info"><span class="ms">forum</span>Responder siempre lo mismo</button>
            <button type="button" class="opt" data-v="control"><span class="ms">inventory</span>Llevar control y reportes</button>
          </div>
        </div>
        <div class="step result" data-step="3" id="result" aria-live="polite"></div>
      </div>
    </div>
  </div>
</section>

@if (Model.Services.Count > 0)
{
<!-- SOLUCIONES -->
<section class="solutions" id="soluciones">
  <div class="wrap">
    <span class="eyebrow reveal">Soluciones</span>
    <h2 class="h2 reveal d1">Lo que hago, explicado <span class="grad">como se lo explicaría a un amigo</span></h2>
    <p class="lead reveal d2">Sin palabras raras. Qué es, para quién sirve y qué obtienes al final.</p>
    <div class="tabs reveal d3" id="tabs" role="tablist">
      @for (var i = 0; i < Model.Services.Count; i++)
      {
        <button type="button" class="tab @(i == 0 ? "on" : "")" data-t="@i"><span class="ms">@Model.Services[i].Icon</span>@Model.Services[i].Title</button>
      }
    </div>
    @for (var i = 0; i < Model.Services.Count; i++)
    {
      var service = Model.Services[i];
      var highlights = service.HighlightList.ToList();
      <div class="card panel @(i == 0 ? "on" : "") @(highlights.Count == 0 ? "no-art" : "")" data-p="@i">
        <div class="panel-copy">
          <h3>@service.Title</h3>
          <p>@service.Description</p>
          <div class="kv">
            @if (!string.IsNullOrWhiteSpace(service.IdealFor)) { <div><small>IDEAL PARA</small><span>@service.IdealFor</span></div> }
            @if (!string.IsNullOrWhiteSpace(service.Includes)) { <div><small>OBTIENES</small><span>@service.Includes</span></div> }
            @if (!string.IsNullOrWhiteSpace(service.Timeframe)) { <div><small>TIEMPO</small><span>@service.Timeframe</span></div> }
          </div>
          <a href="#contacto" class="btn btn-ghost">Platiquemos de esto <span class="ms">arrow_forward</span></a>
        </div>
        @if (highlights.Count > 0)
        {
          <div class="panel-art"><div class="mini"><h4>@service.Title</h4><small>Lo que ves al terminar</small>
            @foreach (var highlight in highlights)
            {
              <div class="mini-row"><span class="ms">@service.Icon</span>@highlight<em>✓</em></div>
            }
          </div></div>
        }
      </div>
    }
  </div>
</section>
}

@if (featured is not null)
{
<!-- PROYECTOS -->
<section id="proyectos">
  <div class="wrap">
    <div class="proj-head">
      <div>
        <span class="eyebrow reveal">Proyectos</span>
        <h2 class="h2 reveal d1">Distintos negocios, <span class="grad">distintas soluciones</span></h2>
        <p class="lead reveal d2">Sitios web, sistemas de gestión y apps móviles. Cada proyecto se hizo a la medida de cómo trabaja ese negocio.</p>
      </div>
      @if (Model.Projects.Count > 1 && presentTypes.Count > 1)
      {
        <div class="filters reveal d3" id="filters">
          <button type="button" class="tab on" data-f="all">Todos</button>
          @foreach (var type in presentTypes)
          {
            <button type="button" class="tab" data-f="@type.Key"><span class="ms">@type.Icon</span>@type.Label</button>
          }
        </div>
      }
    </div>

    <article class="card featured pitem reveal" data-type="@string.Join(' ', featured.TypeList)">
      <div class="feat-media">
        <div class="screens" id="screens">
          @for (var i = 0; i < featuredScreens.Count; i++)
          {
            <img class="desk @(i == 0 ? "on" : "")" src="@featuredScreens[i].Url" alt="@featured.Title: @featuredScreens[i].Label" loading="lazy">
          }
        </div>
        @if (!string.IsNullOrWhiteSpace(featured.MobileImageUrl))
        {
          <img class="mob" src="@featured.MobileImageUrl" alt="@featured.Title en celular" loading="lazy">
        }
        @if (featuredScreens.Count > 1)
        {
          <div class="screen-tabs" id="screenTabs">
            @for (var i = 0; i < featuredScreens.Count; i++)
            {
              <button type="button" class="@(i == 0 ? "on" : "")">@(string.IsNullOrWhiteSpace(featuredScreens[i].Label) ? $"Vista {i + 1}" : featuredScreens[i].Label)</button>
            }
          </div>
        }
      </div>
      <div class="feat-copy">
        <div class="types">
          @foreach (var type in TypesOf(featured)) { <span class="type @type.Css"><span class="ms">@type.Icon</span>@type.Label.ToUpperInvariant()</span> }
          @if (!string.IsNullOrWhiteSpace(featured.Badge)) { <span class="type t-new">@featured.Badge.ToUpperInvariant()</span> }
        </div>
        <h3>@featured.Title</h3>
        <p>@featured.Description</p>
        @if (featured.FeatureList.Any())
        {
          <div class="chips">@foreach (var feature in featured.FeatureList) { <span>@feature</span> }</div>
        }
        @if (!string.IsNullOrWhiteSpace(featured.WebsiteUrl))
        {
          <a href="@featured.WebsiteUrl" target="_blank" rel="noopener" class="btn btn-ghost">Visitar sitio <span class="ms">open_in_new</span></a>
        }
        else
        {
          <a href="#contacto" class="btn btn-ghost">Quiero algo así para mi negocio <span class="ms">arrow_forward</span></a>
        }
      </div>
    </article>

    @if (others.Count > 0)
    {
      <div class="proj-grid" id="projGrid">
        @for (var i = 0; i < others.Count; i++)
        {
          var project = others[i];
          var isApp = project.TypeList.Contains("app");
          var cardImage = isApp ? project.MobileImageUrl ?? project.DesktopImageUrl : project.DesktopImageUrl ?? project.MobileImageUrl;
          <article class="card pcard pitem reveal d@(i % 3 + 1)" data-type="@string.Join(' ', project.TypeList)">
            <div class="pmedia" style="background:@cardBackgrounds[i % cardBackgrounds.Length]">
              @if (!string.IsNullOrWhiteSpace(cardImage))
              {
                <img class="@(isApp ? "app-shot" : "web-shot")" src="@cardImage" alt="@project.Title" loading="lazy">
              }
              else
              {
                <span class="ms pmedia-icon">@(TypesOf(project).FirstOrDefault().Icon ?? "work")</span>
              }
            </div>
            <div class="pbody">
              <div class="types">
                @foreach (var type in TypesOf(project)) { <span class="type @type.Css"><span class="ms">@type.Icon</span>@type.Label.ToUpperInvariant()</span> }
                @if (!string.IsNullOrWhiteSpace(project.Badge)) { <span class="type t-new">@project.Badge.ToUpperInvariant()</span> }
              </div>
              <h4>@project.Title</h4>
              <p>@project.Description</p>
              @if (!string.IsNullOrWhiteSpace(project.WebsiteUrl))
              {
                <a href="@project.WebsiteUrl" target="_blank" rel="noopener">@(isApp ? "Ver app" : "Visitar sitio") <span class="ms" style="font-size:17px">open_in_new</span></a>
              }
            </div>
          </article>
        }
      </div>
    }
    <p class="proj-more reveal">¿Tu negocio no se parece a ninguno? <a href="#diagnostico">Haz el diagnóstico</a> y lo vemos.</p>
  </div>
</section>
}

<!-- CONFIANZA -->
<section class="trust-sec" id="confianza">
  <div class="wrap">
    <div class="head-center">
      <span class="eyebrow reveal">Trabajar sin riesgo</span>
      <h2 class="h2 reveal d1">Sé que es difícil confiar en alguien<br><span class="grad">que todavía no conoces</span>.</h2>
      <p class="lead reveal d2">Por eso trabajo con reglas claras desde el primer día.</p>
    </div>
    <div class="guar">
      <div class="card g reveal"><span class="ms">visibility</span><h3>Ves avances cada semana</h3><p>Te comparto un enlace donde ves tu proyecto creciendo en tiempo real. Nada de desaparecer un mes.</p></div>
      <div class="card g reveal d1"><span class="ms">key</span><h3>Todo es tuyo</h3><p><span class="term" tabindex="0" data-term="dominio">Dominio</span>, <span class="term" tabindex="0" data-term="hosting">hosting</span> y <span class="term" tabindex="0" data-term="codigo">código</span> quedan a tu nombre. Si un día quieres cambiar de proveedor, te vas con todo.</p></div>
      <div class="card g reveal d2"><span class="ms">handshake</span><h3>Precio cerrado por escrito</h3><p>Antes de empezar sabes exactamente qué incluye y cuánto cuesta. Sin cobros sorpresa.</p></div>
      <div class="card g reveal"><span class="ms">translate</span><h3>Te hablo en tu idioma</h3><p>Cero tecnicismos. Si algo no se entiende, el problema es mío, no tuyo.</p></div>
      <div class="card g reveal d1"><span class="ms">school</span><h3>Te enseño a usarlo</h3><p>Al entregar te capacito a ti y a tu equipo, con un video de apoyo para después.</p></div>
      <div class="card g reveal d2"><span class="ms">support_agent</span><h3>No te dejo solo</h3><p>Soporte después del lanzamiento para ajustes y dudas. Trato directo conmigo.</p></div>
    </div>
    <div class="card pay reveal">
      <div><h3>Pagas conforme avanzamos</h3><p>Nunca pagas el 100% por adelantado.</p></div>
      <div class="pay-bar" id="payBar">
        <div><b>30%</b><small>Al arrancar el proyecto</small></div>
        <div><b>40%</b><small>Al aprobar el diseño y la primera versión</small></div>
        <div><b>30%</b><small>Al entregar y quedar satisfecho</small></div>
      </div>
    </div>
  </div>
</section>

<!-- PROCESO -->
<section id="proceso">
  <div class="wrap process">
    <div class="sticky">
      <span class="eyebrow reveal">Cómo trabajamos</span>
      <h2 class="h2 reveal d1">De la primera llamada a <span class="grad">tu negocio en línea</span></h2>
      <p class="lead reveal d2">Un proceso claro, en 4 pasos. Siempre sabes en qué etapa vamos y qué sigue.</p>
    </div>
    <div class="timeline" id="timeline">
      <div class="tl-fill" id="tlFill"></div>
      <div class="st"><div class="dot">01</div><small>SEMANA 0 · GRATIS</small><h3>Platicamos de tu negocio</h3><p>Una llamada de 30 minutos. Entiendo cómo trabajas, qué te frena y qué quieres lograr.</p><span class="you"><span class="ms">person</span>Tú: contarme de tu negocio</span></div>
      <div class="st"><div class="dot">02</div><small>2–3 DÍAS</small><h3>Propuesta clara y precio cerrado</h3><p>Te entrego por escrito qué voy a hacer, cuánto tarda y cuánto cuesta. Si no te convence, no pasa nada.</p><span class="you"><span class="ms">person</span>Tú: revisar y decidir</span></div>
      <div class="st"><div class="dot">03</div><small>SEGÚN PROYECTO</small><h3>Diseño y construcción</h3><p>Primero ves el diseño y lo ajustamos juntos. Después lo construyo y lo revisas cada semana.</p><span class="you"><span class="ms">person</span>Tú: dar tu opinión en cada avance</span></div>
      <div class="st"><div class="dot">04</div><small>ENTREGA</small><h3>Lanzamiento y capacitación</h3><p>Publicamos, te enseño a usarlo y me quedo pendiente las primeras semanas por si algo se ofrece.</p><span class="you"><span class="ms">person</span>Tú: empezar a recibir clientes</span></div>
    </div>
  </div>
</section>

<!-- QUIÉN ESTÁ DETRÁS -->
<section class="about">
  <div class="wrap">
    <div class="portrait reveal">
      <img class="me" src="/assets/img/raul.jpg" alt="@Model.Settings.OwnerName, @Model.Settings.Headline" loading="lazy">
      <div class="badge"><span class="ms" style="color:var(--accent)">verified</span><div><strong>@Model.Settings.OwnerName</strong><small>@Model.Settings.Headline@(string.IsNullOrWhiteSpace(Model.Settings.Location) ? "" : $" · {Model.Settings.Location}")</small></div></div>
    </div>
    <div>
      <span class="eyebrow reveal">Quién está detrás</span>
      <h2 class="h2 reveal d1">Hablas conmigo, <span class="grad">no con una agencia</span>.</h2>
      <p class="lead reveal d2">Soy Raúl, desarrollador web Full Stack en Puebla. Llevo más de 5 años ayudando a PyMEs y emprendedores a tener presencia en internet y a automatizar lo que hoy hacen a mano. Desde la primera llamada hasta el soporte, tratas directamente conmigo.</p>
      <div class="stats">
        <div class="card stat reveal"><b data-count="5" data-prefix="+">+5</b><small>años de experiencia</small></div>
        <div class="card stat reveal d1"><b data-count="24" data-suffix=" h">24 h</b><small>tiempo máximo de respuesta</small></div>
        <div class="card stat reveal d2"><b data-count="100" data-suffix="%">100%</b><small>del proyecto queda a tu nombre</small></div>
      </div>
      <p class="quote reveal d3">"Mi trabajo no es hacer páginas bonitas. Es que tu negocio consiga más clientes."</p>
    </div>
  </div>
</section>

@if (Model.Faqs.Count > 0)
{
<!-- FAQ -->
<section id="faq">
  <div class="wrap">
    <div class="head-center" style="margin-bottom:0">
      <span class="eyebrow reveal">Preguntas frecuentes</span>
      <h2 class="h2 reveal d1">Lo que todos preguntan <span class="grad">antes de decidirse</span></h2>
    </div>
    <div class="faq">
      @for (var i = 0; i < Model.Faqs.Count; i++)
      {
        <div class="card qa @(i == 0 ? "open" : "") reveal d@(Math.Min(i, 4))"><button type="button" aria-expanded="@(i == 0 ? "true" : "false")">@Model.Faqs[i].Question<span class="ms">add</span></button><div class="ans"><div><p>@Model.Faqs[i].Answer</p></div></div></div>
      }
    </div>
  </div>
</section>
}

<!-- CONTACTO -->
<section class="final" id="contacto">
  <div class="wrap">
    <div class="final-card reveal">
      <div>
        <span class="eyebrow">Primer paso</span>
        <h2>Platiquemos 30 minutos. <span class="grad">Gratis y sin compromiso.</span></h2>
        <p>Cuéntame de tu negocio y te digo, con toda honestidad, si puedo ayudarte y cómo. Si no soy la mejor opción para ti, también te lo digo.</p>
        <div class="channels">
          @if (whatsAppUrl.Length > 0)
          {
            <a class="channel" href="@whatsAppUrl" target="_blank" rel="noopener"><span class="ic" style="background:rgba(37,211,102,.14);color:#25D366"><span class="ms">chat</span></span><div><strong>WhatsApp</strong><small>@Model.Settings.Phone · la vía más rápida</small></div></a>
          }
          @if (!string.IsNullOrWhiteSpace(Model.Settings.Email))
          {
            <a class="channel" href="mailto:@Model.Settings.Email"><span class="ic" style="background:rgba(74,158,255,.14);color:var(--primary)"><span class="ms">mail</span></span><div><strong>Correo</strong><small>@Model.Settings.Email</small></div></a>
          }
        </div>
      </div>
      <form class="form" id="contactForm" asp-controller="Home" asp-action="Contact" method="post" novalidate>
        <input type="hidden" name="source" id="contactSource" value="formulario">
        <input type="hidden" name="diagnosticAnswers" id="contactDiagnostic" value="">
        <div class="row">
          <label>Tu nombre<input name="name" required minlength="2" maxlength="120" autocomplete="name" placeholder="Ej. Ana López"></label>
          <label>WhatsApp o correo<input id="contactReach" required maxlength="160" autocomplete="on" inputmode="email" placeholder="Para responderte"></label>
        </div>
        <label>¿Qué te interesa?<select id="contactService" name="serviceCategory" required>
          <option value="" disabled selected>Selecciona una opción</option>
          @foreach (var service in Model.Services) { <option value="@service.Title">@service.Title</option> }
          <option value="Otro">Otro / aún no lo sé</option>
        </select></label>
        <label>Cuéntame un poco<textarea id="contactMessage" name="message" required minlength="10" maxlength="3000" placeholder="Ej. Tengo un spa y quiero que mis clientas agenden en línea…"></textarea></label>
        <button type="submit" class="btn btn-primary" style="justify-content:center">Quiero mi llamada gratis <span class="ms">send</span></button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
        <span class="note"><span class="ms" style="font-size:16px">lock</span>Tus datos solo se usan para responderte.</span>
      </form>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <span class="mono">&gt;_ raul.dev</span>
    <span class="foot-links">
      @if (!string.IsNullOrWhiteSpace(Model.Settings.LinkedInUrl)) { <a href="@Model.Settings.LinkedInUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a> }
      @if (!string.IsNullOrWhiteSpace(Model.Settings.GitHubUrl)) { <a href="@Model.Settings.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a> }
      <a href="@adminUrl" class="mono" aria-label="Panel administrativo">_admin</a>
    </span>
    <span>© @DateTime.Now.Year @Model.Settings.OwnerName@(string.IsNullOrWhiteSpace(Model.Settings.Location) ? "" : $" · {Model.Settings.Location}")</span>
  </div>
</footer>

@if (whatsAppUrl.Length > 0)
{
<div class="m-bar" id="mBar"><a href="#diagnostico" class="btn btn-ghost"><span class="ms">quiz</span>Diagnóstico</a><a href="@whatsAppUrl" target="_blank" rel="noopener" class="btn btn-wa"><span class="ms">chat</span>WhatsApp</a></div>
}
<div class="tip" id="tip" role="tooltip"><b id="tipT"></b><span id="tipD"></span></div>
<button type="button" class="to-top" id="toTop" aria-label="Volver arriba"><svg viewBox="0 0 46 46" aria-hidden="true"><defs><linearGradient id="ttg"><stop offset="0" stop-color="#4A9EFF"/><stop offset="1" stop-color="#00D9A3"/></linearGradient></defs><circle class="trk" cx="23" cy="23" r="21"/><circle class="bar" id="ttBar" cx="23" cy="23" r="21"/></svg><span class="ms">arrow_upward</span></button>
@if (whatsAppUrl.Length > 0)
{
<a class="wa" href="@whatsAppUrl" target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"/></svg></a>
}

<script src="/js/landing.js?v=3" defer></script>
</body>
</html>
