@model IReadOnlyList<Project>
<div class="grid grid-cols-1 @(Model.Count > 1 ? "lg:grid-cols-2" : "") gap-8 w-full">
@foreach (var project in Model)
{
    <article data-category="@project.Category" class="project-item project-card group relative cursor-pointer reveal-scale w-full">
        <div class="browser-frame">
            <div class="browser-titlebar"><div class="browser-dots"><span class="browser-dot" style="background:#FF5F57"></span><span class="browser-dot" style="background:#FEBC2E"></span><span class="browser-dot" style="background:#28C840"></span></div><div class="browser-addressbar"><span class="material-symbols-outlined" style="font-size:12px;opacity:.5">lock</span><span>@(Uri.TryCreate(project.WebsiteUrl, UriKind.Absolute, out var siteUri) ? siteUri.Host : project.Slug)</span></div><div style="width:52px"></div></div>
            <div class="browser-viewport"><img alt="@project.Title" class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105" src="@(project.DesktopImageUrl ?? "/assets/img/everglow.png")" loading="lazy" decoding="async" /></div>
        </div>
        <div class="portfolio-glass-overlay absolute inset-0 z-20 flex flex-col items-center justify-center p-8 text-center opacity-0 group-hover:opacity-100 transition-all duration-400 translate-y-3 group-hover:translate-y-0">
            <span class="app-badge mb-3">@project.Badge</span><h3 class="text-2xl font-black mb-2" style="color:#fff">@project.Title</h3>
            <div class="flex flex-wrap gap-2 justify-center mb-6">@foreach (var technology in project.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)){<span class="tech-pill bg-primary/20 text-primary border-primary/30">@technology</span>}</div>
            <button type="button" onclick="openProjectModal('@project.Slug')" class="animated-gradient-btn px-7 py-3 rounded-xl font-bold text-sm flex items-center gap-2 hover:scale-105 transition-all neon-btn-glow" style="color:#fff">Ver Proyecto <span class="material-symbols-outlined text-[18px]">open_in_new</span></button>
        </div>
    </article>
}
</div>
