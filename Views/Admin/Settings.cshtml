@model SiteSettings
@{
    ViewData["Title"] = "Configuración";
    ViewData["Crumb"] = "configuración";
    var socialNetworks = string.Join(" · ", new[] { string.IsNullOrWhiteSpace(Model.LinkedInUrl) ? null : "LinkedIn", string.IsNullOrWhiteSpace(Model.GitHubUrl) ? null : "GitHub" }.Where(x => x is not null));
}
<div class="page-head">
    <div><h1>Configuración</h1><p>Tus datos de contacto, cómo te presentas y cómo te encuentra Google.</p></div>
    <div class="actions">
        <button type="button" class="btn btn-ghost" data-modal-url="@Url.Action("Seo")"><span class="ms">travel_explore</span>Editar SEO</button>
        <button type="button" class="btn" data-modal-url="@Url.Action("Settings", new { modal = true })"><span class="ms">edit</span>Editar datos</button>
    </div>
</div>
<div class="settings-grid">
    <section class="card scard"><span class="row-icon"><span class="ms">badge</span></span><div><span class="eyebrow">Identidad</span><h3>@Model.OwnerName</h3><p>@Model.Headline</p></div></section>
    <section class="card scard"><span class="row-icon"><span class="ms">chat</span></span><div><span class="eyebrow">WhatsApp</span><h3>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Sin configurar" : Model.Phone)</h3><p>Lo usan todos los botones de WhatsApp del sitio.</p></div></section>
    <section class="card scard"><span class="row-icon"><span class="ms">mail</span></span><div><span class="eyebrow">Correo</span><h3>@(string.IsNullOrWhiteSpace(Model.Email) ? "Sin configurar" : Model.Email)</h3><p>Aquí te llega el aviso de cada mensaje nuevo.</p></div></section>
    <section class="card scard"><span class="row-icon"><span class="ms">location_on</span></span><div><span class="eyebrow">Ubicación</span><h3>@(string.IsNullOrWhiteSpace(Model.Location) ? "Sin configurar" : Model.Location)</h3><p>Aparece en el hero y en el pie de página.</p></div></section>
    <section class="card scard wide"><span class="row-icon"><span class="ms">campaign</span></span><div><span class="eyebrow">Presentación principal</span><h3>Texto debajo del título del hero</h3><p>@(string.IsNullOrWhiteSpace(Model.HeroText) ? "Sin texto: se usa el texto por defecto del sitio." : Model.HeroText)</p></div></section>
    <section class="card scard"><span class="row-icon"><span class="ms">share</span></span><div><span class="eyebrow">Redes</span><h3>LinkedIn y GitHub</h3><p>@(socialNetworks.Length > 0 ? $"{socialNetworks} en el pie de página" : "Sin redes configuradas")</p></div></section>
    <section class="card scard"><span class="row-icon"><span class="ms">travel_explore</span></span><div><span class="eyebrow">SEO</span><h3>@(string.IsNullOrWhiteSpace(Model.SeoTitle) ? "Sin configurar" : Model.SeoTitle)</h3><p><span class="chip @(Model.IsIndexable ? "stage-nuevo" : "src")">@(Model.IsIndexable ? "Visible en Google" : "Oculto para buscadores")</span></p></div></section>
</div>
