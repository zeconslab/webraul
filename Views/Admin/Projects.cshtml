@model IReadOnlyList<Project>
@{ ViewData["Title"]="Proyectos"; }
<div class="module-head">@await Html.PartialAsync("_ModuleHead", new ModuleHeadViewModel("proyectos", "Proyectos", "Publica casos de estudio, tecnologías, enlaces e imágenes."))<button type="button" class="button" data-modal-url="@Url.Action("Project", new { modal = true })"><b class="material-symbols-outlined">add</b>Nuevo proyecto</button></div>
@await Html.PartialAsync("_ModuleTable", ("Project", Model.Select(x => (x.Id,x.Title,x.Description,x.IsPublished,x.SortOrder)).ToList()))
