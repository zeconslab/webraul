@model ServiceItem
<form asp-action="Service" method="post" class="admin-modal-form" data-modal-form>
    <input asp-for="Id" type="hidden" />
    <div class="modal-form-head"><div><span class="module-kicker">SERVICIOS</span><h2>@(Model.Id == 0 ? "Nuevo servicio" : "Editar servicio")</h2><p>Define cómo se presenta esta solución en el sitio público.</p></div><button type="button" class="modal-close" data-modal-close aria-label="Cerrar"><b class="material-symbols-outlined">close</b></button></div>
    <div class="modal-form-body"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Title">Título</label><input asp-for="Title" /><span asp-validation-for="Title"></span></div><div class="field"><label asp-for="Description">Descripción</label><textarea asp-for="Description"></textarea><span asp-validation-for="Description"></span></div><div class="form-grid"><div class="field"><label asp-for="Icon">Icono Material</label><input asp-for="Icon" /><small>Ejemplo: code, public o design_services</small></div><div class="field"><label asp-for="SortOrder">Orden</label><input asp-for="SortOrder" type="number" /></div></div><label class="publish-control"><input asp-for="IsPublished" /><span><strong>Publicado</strong><small>Visible inmediatamente en el sitio público</small></span></label></div>
    <div class="modal-form-actions"><button type="button" class="button secondary" data-modal-close>Cancelar</button><button class="button" type="submit"><b class="material-symbols-outlined">save</b>Guardar servicio</button></div>
</form>
