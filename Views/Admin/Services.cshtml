@model IReadOnlyList<ServiceItem>
@{ ViewData["Title"]="Servicios"; }
<div class="module-head">@await Html.PartialAsync("_ModuleHead", new ModuleHeadViewModel("servicios", "Servicios", "Administra las soluciones que aparecen en la sección de servicios."))<button type="button" class="button" data-modal-url="@Url.Action("Service", new { modal = true })"><b class="material-symbols-outlined">add</b>Nuevo servicio</button></div>
@await Html.PartialAsync("_ModuleTable", ("Service", Model.Select(x => (x.Id,x.Title,x.Description,x.IsPublished,x.SortOrder)).ToList()))
