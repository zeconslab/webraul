@model AppItem
<form asp-action="App" method="post" enctype="multipart/form-data" class="admin-modal-form" data-modal-form>
    <input asp-for="Id" type="hidden" /><input asp-for="ImageUrl" type="hidden" />
    <div class="modal-form-head"><div><span class="module-kicker">APLICACIONES</span><h2>@(Model.Id == 0 ? "Nueva aplicación" : "Editar aplicación")</h2><p>Configura un producto personal u open source.</p></div><button type="button" class="modal-close" data-modal-close aria-label="Cerrar"><b class="material-symbols-outlined">close</b></button></div>
    <div class="modal-form-body">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field"><label asp-for="Name">Nombre</label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
        <div class="field"><label asp-for="Description">Descripción</label><textarea asp-for="Description"></textarea><span asp-validation-for="Description"></span></div>
        <div class="field"><label asp-for="ProjectType">Tipo de aplicación</label><select asp-for="ProjectType"><option value="personal">Proyecto personal</option><option value="client">Empresa o cliente</option><option value="opensource">Open source</option><option value="leisure">Ocio o entretenimiento</option><option value="experimental">Proyecto experimental</option><option value="community">Comunidad o colaboración</option></select><small>Esta clasificación aparecerá como insignia en el sitio público.</small></div>
        <div class="field"><label asp-for="Technologies">Tecnologías</label><div class="tag-editor" data-tag-editor><div class="tag-list"></div><input type="text" data-tag-input placeholder="Escribe y presiona coma o Enter" autocomplete="off" /><input asp-for="Technologies" type="hidden" data-tag-value /></div></div>
        <div class="field"><label>Imagen de la aplicación</label><label class="file-drop file-drop-preview" data-file-drop><input name="appImage" type="file" accept="image/png,image/jpeg,image/webp" data-file-input /><img data-file-preview src="@Model.ImageUrl" alt="Vista previa de la aplicación" class="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "" : "has-image")" /><span class="file-drop-copy"><b class="material-symbols-outlined">add_photo_alternate</b><strong>Portada o captura</strong><small data-file-name>Arrastra o selecciona · PNG, JPG o WEBP</small></span></label></div>
        <div class="form-grid">
            <div class="field"><label asp-for="Icon">Categoría e icono</label><div class="icon-select-wrap"><span class="material-symbols-outlined" data-icon-preview>@(string.IsNullOrWhiteSpace(Model.Icon) ? "apps" : Model.Icon)</span><select asp-for="Icon" data-icon-select><option value="apps">General · Aplicación</option><option value="smartphone">Móvil · Smartphone</option><option value="language">Web · Plataforma</option><option value="deployed_code">Software · Desarrollo</option><option value="construction">Herramientas · Utilidades</option><option value="psychology">IA · Inteligencia artificial</option><option value="sports_esports">Juegos · Entretenimiento</option><option value="task_alt">Productividad · Tareas</option><option value="shopping_cart">Comercio · Tienda</option><option value="payments">Finanzas · Pagos</option><option value="school">Educación · Aprendizaje</option><option value="favorite">Salud · Bienestar</option><option value="groups">Social · Comunidad</option><option value="travel_explore">Viajes · Exploración</option><option value="photo_camera">Multimedia · Fotografía</option><option value="music_note">Multimedia · Música</option><option value="news">Contenido · Noticias</option><option value="cloud">Servicios · Nube</option><option value="security">Seguridad · Protección</option><option value="analytics">Datos · Analítica</option></select></div></div>
            <div class="field"><label asp-for="SortOrder">Orden</label><input asp-for="SortOrder" type="number" /></div>
        </div>
        <div class="field"><label asp-for="Url">Enlace público</label><input asp-for="Url" type="url" placeholder="https://" /><span asp-validation-for="Url"></span></div>
        <label class="publish-control"><input asp-for="IsPublished" /><span><strong>Publicada</strong><small>Visible en el sitio público</small></span></label>
    </div>
    <div class="modal-form-actions"><button type="button" class="button secondary" data-modal-close>Cancelar</button><button class="button" type="submit"><b class="material-symbols-outlined">save</b>Guardar aplicación</button></div>
</form>
