@model AdminContentViewModel
@{ ViewData["Title"] = "Contenido"; }
<div class="page-head"><div><h1>Contenido</h1><p class="muted">Todo lo visible en el sitio se administra aquí.</p></div></div>
<section class="card"><h2>Datos generales</h2><form asp-action="Settings" method="post" class="admin-form"><input asp-for="Settings.Id" type="hidden"><div class="field"><label asp-for="Settings.OwnerName">Nombre</label><input asp-for="Settings.OwnerName"></div><div class="field"><label asp-for="Settings.Headline">Título profesional</label><input asp-for="Settings.Headline"></div><div class="field"><label asp-for="Settings.HeroText">Presentación</label><textarea asp-for="Settings.HeroText"></textarea></div><div class="grid" style="grid-template-columns:1fr 1fr"><div class="field"><label asp-for="Settings.Email">Email</label><input asp-for="Settings.Email"></div><div class="field"><label asp-for="Settings.Phone">Teléfono</label><input asp-for="Settings.Phone"></div></div><div class="field"><label asp-for="Settings.Location">Ubicación</label><input asp-for="Settings.Location"></div><div class="field"><label asp-for="Settings.LinkedInUrl">LinkedIn</label><input asp-for="Settings.LinkedInUrl"></div><div class="field"><label asp-for="Settings.GitHubUrl">GitHub</label><input asp-for="Settings.GitHubUrl"></div><button class="button">Guardar datos generales</button></form></section>
@await Html.PartialAsync("_ContentTable", ("Servicios", "Service", Model.Services.Select(x => (x.Id,x.Title,x.IsPublished)).ToList()))
@await Html.PartialAsync("_ContentTable", ("Proyectos", "Project", Model.Projects.Select(x => (x.Id,x.Title,x.IsPublished)).ToList()))
@await Html.PartialAsync("_ContentTable", ("Preguntas frecuentes", "Faq", Model.Faqs.Select(x => (x.Id,x.Question,x.IsPublished)).ToList()))
@await Html.PartialAsync("_ContentTable", ("Aplicaciones", "App", Model.Apps.Select(x => (x.Id,x.Name,x.IsPublished)).ToList()))
