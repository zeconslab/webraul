@model IReadOnlyList<ContactMessage>
@{ ViewData["Title"] = "Mensajes"; }
<div class="page-head"><div><h1>Mensajes</h1><p class="muted">Solicitudes enviadas desde el formulario público.</p></div></div><div class="grid">@foreach(var item in Model){<article class="card @(item.IsRead ? "" : "message-unread")"><div class="page-head" style="margin-bottom:12px"><div><strong>@item.Name</strong> · <a href="mailto:@item.Email">@item.Email</a></div><span class="muted">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div><p style="white-space:pre-wrap">@item.Message</p>@if(!item.IsRead){<form asp-action="ReadMessage" method="post"><input type="hidden" name="id" value="@item.Id"><button class="button secondary small">Marcar como leído</button></form>}</article>}</div>
