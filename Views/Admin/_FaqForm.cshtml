@model FaqItem
<form asp-action="Faq" method="post" class="admin-modal-form" data-modal-form>
    <input asp-for="Id" type="hidden" />
    <div class="modal-form-head"><div><span class="module-kicker">PREGUNTAS FAQ</span><h2>@(Model.Id == 0 ? "Nueva pregunta" : "Editar pregunta")</h2><p>Redacta una respuesta clara para tus visitantes.</p></div><button type="button" class="modal-close" data-modal-close aria-label="Cerrar"><b class="material-symbols-outlined">close</b></button></div>
    <div class="modal-form-body"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Question">Pregunta</label><input asp-for="Question" /><span asp-validation-for="Question"></span></div><div class="field"><label asp-for="Answer">Respuesta</label><textarea asp-for="Answer" rows="6"></textarea><span asp-validation-for="Answer"></span></div><div class="field field-small"><label asp-for="SortOrder">Orden</label><input asp-for="SortOrder" type="number" /></div><label class="publish-control"><input asp-for="IsPublished" /><span><strong>Publicada</strong><small>Visible en la sección de preguntas frecuentes</small></span></label></div>
    <div class="modal-form-actions"><button type="button" class="button secondary" data-modal-close>Cancelar</button><button class="button" type="submit"><b class="material-symbols-outlined">save</b>Guardar pregunta</button></div>
</form>
