@model (string Title, string Action, List<(int Id, string Name, bool Published)> Items)
<section><div class="section-title"><h2>@Model.Title</h2><button type="button" class="button small" data-modal-url="@Url.Action(Model.Action, new { modal = true })">Nuevo</button></div><div class="card table-wrap"><table class="admin-table"><thead><tr><th>Nombre</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@(item.Published ? "Publicado" : "Oculto")</td><td class="actions"><button type="button" class="button secondary small" data-modal-url="@Url.Action(Model.Action, new { id = item.Id, modal = true })">Editar</button><button type="button" class="button danger small" data-delete-type="@Model.Action" data-delete-id="@item.Id" data-delete-name="@item.Name">Eliminar</button></td></tr>}</tbody></table></div></section>
