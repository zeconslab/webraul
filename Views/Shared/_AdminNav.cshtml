@inject webraul.Data.ApplicationDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string On(params string[] actions) => actions.Contains(currentAction, StringComparer.OrdinalIgnoreCase) ? "on" : string.Empty;
    var waiting = await Db.ContactMessages.CountAsync(x => x.Stage == LeadStages.New);
    var incompleteServices = await Db.Services.AnyAsync(x => x.IsPublished && (x.IdealFor == "" || x.Includes == "" || x.Timeframe == ""));
    var settings = await Db.SiteSettings.AsNoTracking().OrderBy(x => x.Id).Select(x => new { x.OwnerName, x.Email }).FirstAsync();
}
<aside class="side" aria-label="Navegación del panel">
    <a class="brand" href="/admin"><span>&gt;_</span><div>raul.dev<small>PANEL</small></div></a>
    <nav class="nav">
        <a class="@On("Index")" asp-controller="Admin" asp-action="Index"><span class="ms">space_dashboard</span>Inicio</a>
        <a class="@On("Messages")" asp-controller="Admin" asp-action="Messages"><span class="ms">inbox</span><span>Clientes</span>@if (waiting > 0) {<span class="count" title="Esperan respuesta">@waiting</span>}</a>
        <div class="nav-label">SITIO</div>
        <a class="@On("Projects", "Project")" asp-controller="Admin" asp-action="Projects"><span class="ms">work</span>Proyectos</a>
        <a class="@On("Services", "Service")" asp-controller="Admin" asp-action="Services"><span class="ms">design_services</span><span>Servicios</span>@if (incompleteServices) {<span class="warn-dot" title="Hay servicios incompletos"></span>}</a>
        <a class="@On("Faqs", "Faq")" asp-controller="Admin" asp-action="Faqs"><span class="ms">help</span>Preguntas</a>
        <a class="@On("Files")" asp-controller="Admin" asp-action="Files"><span class="ms">folder</span>Archivos</a>
        <a class="@On("Settings")" asp-controller="Admin" asp-action="Settings"><span class="ms">tune</span>Configuración</a>
    </nav>
    <div class="side-foot">
        <a class="nav-link" href="/" target="_blank" rel="noopener"><span class="ms">open_in_new</span>Ver sitio</a>
        <div class="me">
            <img src="/assets/img/raul.jpg" alt="" />
            <div><strong>@settings.OwnerName</strong><small>@(User.Identity?.Name ?? settings.Email)</small></div>
            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="icon-btn" title="Cerrar sesión" aria-label="Cerrar sesión"><span class="ms">logout</span></button></form>
        </div>
    </div>
</aside>

<nav class="tabbar" aria-label="Navegación móvil">
    <a class="@On("Index")" asp-controller="Admin" asp-action="Index"><span class="ms">space_dashboard</span>Inicio</a>
    <a class="@On("Messages")" asp-controller="Admin" asp-action="Messages"><span class="ms">inbox</span><span>Clientes</span>@if (waiting > 0) {<em>@waiting</em>}</a>
    <a class="@On("Projects", "Project")" asp-controller="Admin" asp-action="Projects"><span class="ms">work</span>Proyectos</a>
    <button type="button" class="@On("Services", "Service", "Faqs", "Faq", "Files", "Settings")" data-sheet-open><span class="ms">menu</span><span>Más</span>@if (incompleteServices) {<i class="warn-dot"></i>}</button>
</nav>
<div class="sheet-layer" id="moreSheet" aria-hidden="true">
    <div class="sheet-scrim" data-sheet-close></div>
    <div class="sheet" role="dialog" aria-label="Más opciones">
        <span class="sheet-grip"></span>
        <a asp-controller="Admin" asp-action="Services"><span class="ms">design_services</span><span>Servicios</span>@if (incompleteServices) {<span class="warn-dot"></span>}</a>
        <a asp-controller="Admin" asp-action="Faqs"><span class="ms">help</span>Preguntas</a>
        <a asp-controller="Admin" asp-action="Files"><span class="ms">folder</span>Archivos</a>
        <a asp-controller="Admin" asp-action="Settings"><span class="ms">tune</span>Configuración</a>
        <a href="/" target="_blank" rel="noopener"><span class="ms">open_in_new</span>Ver sitio</a>
        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit"><span class="ms">logout</span>Cerrar sesión</button></form>
    </div>
</div>
